{
  "id": "/app",
  "name": "ShopOS",
  "short_name": "ShopOS",
  "description": "Orders, customer khata, payments, pickups and stock for your shop, in one place.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f2f5f4",
  "theme_color": "#0f2727",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New order",
      "short_name": "New order",
      "description": "Start a new order",
      "url": "/app?new=1",
      "icons": [{ "src": "/icons/shortcut-new-order.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Pickups",
      "short_name": "Pickups",
      "description": "Orders waiting for pickup and delivery",
      "url": "/app/pickups",
      "icons": [{ "src": "/icons/shortcut-pickups.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
